{
  "hosting": [
    {
      "site": "louvor-hajaluz",
      "public": "apps/web/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "regex": "^/[^.]*$", "destination": "/index.html" }],
      "headers": [
        {
          "source": "**",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/sw.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/assets/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ]
    },
    {
      "site": "louvor-hajaluz-teste",
      "public": "apps/web/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "regex": "^/[^.]*$", "destination": "/index.html" }],
      "headers": [
        {
          "source": "**",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/sw.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/assets/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ]
    },
    {
      "site": "cifras-louvor-5dd50",
      "public": "hosting/legacy",
      "headers": [
        {
          "source": "/sw.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ],
      "redirects": [
        { "source": "/", "destination": "https://louvor-hajaluz.web.app/", "type": 301 },
        {
          "regex": "^/(?P<path>(?:[^s].*|s(?:[^w].*)?|sw(?:[^.].*)?|sw[.](?:[^j].*)?|sw[.]j(?:[^s].*)?|sw[.]js.+))$",
          "destination": "https://louvor-hajaluz.web.app/:path",
          "type": 301
        }
      ]
    }
  ],
  "functions": {
    "source": "apps/functions",
    "runtime": "nodejs22",
    "predeploy": ["npm run build -w @cifras/functions"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "host": "0.0.0.0", "port": 9099 },
    "firestore": { "host": "0.0.0.0", "port": 8080, "websocketPort": 9150 },
    "storage": { "host": "0.0.0.0", "port": 9199 },
    "functions": { "host": "0.0.0.0", "port": 5001 },
    "ui": { "enabled": true, "host": "0.0.0.0", "port": 4000 },
    "hub": { "host": "0.0.0.0", "port": 4400 },
    "logging": { "host": "0.0.0.0", "port": 4500 },
    "singleProjectMode": true
  }
}
