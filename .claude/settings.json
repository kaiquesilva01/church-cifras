{
  "model": "sonnet",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-sonnet-5-5": { "effortLevel": "medium" }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-main.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\"" }]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/release-pr.mjs\"",
            "timeout": 60,
            "statusMessage": "Verificando PR develop → main..."
          }
        ]
      }
    ]
  }
}
