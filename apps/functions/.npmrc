# Cloud Build instala só este package.json (npm 10, sem lockfile). No npm 10.9.x o par
# firebase-admin + firebase-functions quebra com "Cannot read properties of null (reading 'edgesOut')".
# legacy-peer-deps evita o caminho de resolução de peers que causa o erro. As peers opcionais do
# firebase-functions (graphql, @apollo/server...) não são usadas. Ver docs/deploy.md.
legacy-peer-deps=true
