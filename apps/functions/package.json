{
  "name": "@cifras/functions",
  "private": true,
  "version": "0.0.0",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lyrics:backfill": "tsup --config tsup.backfill.config.ts && node lib/backfillCli.mjs",
    "ministries:migrate": "tsup --config tsup.migrate.config.ts && node lib/migrateCli.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "firebase-admin": "14.5.1",
    "firebase-functions": "7.4.0"
  }
}
